{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kumiho Desktop",
  "version": "0.1.3",
  "identifier": "io.kumiho.desktop",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kumiho Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
