{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kumiho Desktop",
  "version": "0.1.0",
  "identifier": "io.kumiho.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "title": "Kumiho Desktop",
        "width": 1280,
        "height": 800,
        "url": "http://127.0.0.1:8090"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
