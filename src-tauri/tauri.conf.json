{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kumiho Desktop",
  "version": "0.3.3",
  "identifier": "io.kumiho.desktop",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KumihoIO/kumiho-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQkIxMjQ4N0ZGQ0Y0QzQKUldURTlQeC9TQks3RVoxbnlpOVUvVkdsNngzNFJxM2RJcWVyS0tnVHFiYURyR2pEWGJvdFpTZU0K"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kumiho Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
